FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Only for FalkorDB Cloud / a password-protected instance
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Tenant graph name; every request overrides this
FALKORDB_GRAPH=dashmart
# Model backend: claude | local | scripted. Unset = local if LOCAL_MODEL_URL is set, else claude if a key exists, else scripted.
BRAIN_BACKEND=
# Claude backend. Never commit the real value.
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-opus-5-5
BRAIN_EFFORT=medium
# Server model ("Server" in the UI dropdown): any OpenAI-compatible endpoint.
# build.nvidia.com (free key from build.nvidia.com, starts with nvapi-):
LOCAL_MODEL_URL=https://integrate.api.nvidia.com/v1
LOCAL_MODEL_KEY=
LOCAL_MODEL=openai/gpt-oss-20b
LOCAL_TIMEOUT=120
# Your own host instead: LOCAL_MODEL_URL=http://<host>:11434/v1 (Ollama) and LOCAL_MODEL=gpt-oss:20b, key empty
# Optional: LOCAL_REASONING_EFFORT=low|medium|high   LOCAL_TEMPERATURE=0.2
